# GPG keyring / private signing material — MUST NEVER be committed.
# The public key is distributed as tilas01.asc in the repo root; that is the
# only key material that belongs in version control.
.keys/
*.key
*.gpg
secring.*
private-keys-v1.d/

# Node dependencies for the test suite. package.json pins the versions;
# node_modules is reproducible from it and does not belong in git.
node_modules/

# Misc
*.pyc
__pycache__/
